          "response": [
            {
              "name": "Пример ответа (200 OK)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "[\n  {\n    \"id\": 1,\n    \"patient_fio\": \"Иванова Мария Сергеевна\",\n    \"doctor_fio\": \"Петрова Елена Андреевна\",\n    \"category_name\": \"Кардиология\",\n    \"datetime_slot\": \"2026-11-06 09:00\",\n    \"status_name\": \"Завершен\"\n  }\n]"
            }
          ]
        },
        {
          "name": "8. Успешное бронирование онлайн-записи",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": 6,\n  \"doctor_id\": 4,\n  \"category_id\": 4,\n  \"datetime_slot\": \"2026-11-08 17:00\"\n}"
            },
            "url": { "raw": "http://127.0.0" }
          },
          "response": [
            {
              "name": "Пример ответа (21 Created)",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"created\",\n  \"appointment_id\": 12,\n  \"datetime_slot\": \"2026-11-08 17:00\"\n}"
            }
          ]
        },
        {
          "name": "9. Ошибка: Race Condition (Слот уже занят)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": 5,\n  \"doctor_id\": 4,\n  \"category_id\": 4,\n  \"datetime_slot\": \"2026-11-08 17:00\"\n}"
            },
            "url": { "raw": "http://127.0.0" }
          },
          "response": [
            {
              "name": "Пример ответа (409 Conflict)",
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"error\",\n  \"code\": \"SLOT_ALREADY_BOOKED\",\n  \"message\": \"Конфликт бронирования: Этот временной слот у врача уже занят другим параллельным запросом.\",\n  \"details\": null\n}"
            }
          ]
        },
        {
          "name": "10. Каскадное удаление записи администратором",
          "request": {
            "method": "DELETE",
            "url": { "raw": "http://127.0.0/12" }
