# =================================================================
# ШАБЛОН НАСТРОЕК ОКРУЖЕНИЯ ПРИЛОЖЕНИЯ (MEDICAL BOOKING SYSTEM)
# Скопируйте этот файл под именем .env и укажите свои параметры
# =================================================================

# Настройки конфигурации веб-сервера FastAPI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG_MODE=true

# Параметры подключения к реляционной СУБД SQLite
DB_PATH=medical.db
DB_FOREIGN_KEYS=true
